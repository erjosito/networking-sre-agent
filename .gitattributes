# Enforce LF for files consumed by Linux at runtime. CRLF here breaks tools:
# e.g. a trailing \r in FRR's /etc/frr/daemons makes bgpd_options="-A 127.0.0.1\r"
# fail with "getaddrinfo failed" and bgpd never starts.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
infra/containerlab/configs/**   text eol=lf
infra/cloud-init/**             text eol=lf
Dockerfile      text eol=lf

# PowerShell scripts stay CRLF-friendly (Windows-authored/consumed).
*.ps1           text eol=crlf
